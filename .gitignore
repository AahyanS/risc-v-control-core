# Compiled Icarus Verilog simulation binaries
sim_*

# Waveform dumps
*.vcd

# Compiled RISC-V program binaries (regenerate from sw/*.c, sw/*.s with
# riscv-none-elf-gcc) - the .hex files they produce ARE committed,
# since testbenches read those directly via $readmemh
sw/*.elf
sw/*.o

# Compliance suite build output - regenerate with ./run_compliance.sh
build_compliance/

# Co-simulation trace output - regenerate by running tb_cosim.v and
# cosim/iss.py against a given hex file
cosim/*.trace

# Vivado build output and scratch files - regenerate with
# vivado -mode batch -source fpga/build.tcl
fpga/build/
.Xil/
vivado*.jou
vivado*.log
vivado*.str
usage_statistics_webtalk.*
